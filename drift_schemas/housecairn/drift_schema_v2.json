      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"homes\" (\"id\" BLOB NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"name\" TEXT NOT NULL, \"currency\" TEXT NOT NULL DEFAULT 'EUR', \"hemisphere\" TEXT NOT NULL DEFAULT 'north', \"archived_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "rooms",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rooms\" (\"id\" BLOB NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"home_id\" BLOB NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL DEFAULT 'other', \"position\" INTEGER NOT NULL DEFAULT 0, \"notes\" TEXT NOT NULL DEFAULT '', \"paint_colour\" TEXT NOT NULL DEFAULT '', \"paint_brand\" TEXT NOT NULL DEFAULT '', \"paint_reference\" TEXT NOT NULL DEFAULT '', \"paint_batch\" TEXT NOT NULL DEFAULT '', \"floor_covering\" TEXT NOT NULL DEFAULT '', \"wall_covering\" TEXT NOT NULL DEFAULT '', \"memory_notes\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"items\" (\"id\" BLOB NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"home_id\" BLOB NOT NULL, \"room_id\" BLOB NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL DEFAULT 'equipment', \"brand\" TEXT NOT NULL DEFAULT '', \"model\" TEXT NOT NULL DEFAULT '', \"serial_number\" TEXT NOT NULL DEFAULT '', \"installed_on\" TEXT NULL, \"warranty_ends_on\" TEXT NULL, \"contract_contractor_id\" BLOB NULL, \"contract_number\" TEXT NOT NULL DEFAULT '', \"contract_url\" TEXT NOT NULL DEFAULT '', \"links\" TEXT NOT NULL DEFAULT '[]', \"notes\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "photos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"photos\" (\"id\" BLOB NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"home_id\" BLOB NOT NULL, \"room_id\" BLOB NULL, \"item_id\" BLOB NULL, \"category\" TEXT NOT NULL DEFAULT 'general', \"caption\" TEXT NOT NULL DEFAULT '', \"image\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "contractors",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"contractors\" (\"id\" BLOB NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"home_id\" BLOB NOT NULL, \"name\" TEXT NOT NULL, \"trade\" TEXT NOT NULL DEFAULT '', \"trade_other\" TEXT NOT NULL DEFAULT '', \"phone\" TEXT NOT NULL DEFAULT '', \"email\" TEXT NOT NULL DEFAULT '', \"address\" TEXT NOT NULL DEFAULT '', \"note\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" BLOB NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"home_id\" BLOB NOT NULL, \"title\" TEXT NOT NULL, \"room_id\" BLOB NULL, \"item_id\" BLOB NULL, \"priority\" TEXT NOT NULL DEFAULT 'normal', \"estimated_minutes\" INTEGER NULL, \"notes\" TEXT NOT NULL DEFAULT '', \"procedure\" TEXT NOT NULL DEFAULT '', \"contractor_id\" BLOB NULL, \"repeat_mode\" TEXT NOT NULL DEFAULT 'once', \"repeat_unit\" TEXT NOT NULL DEFAULT 'month', \"repeat_interval\" INTEGER NOT NULL DEFAULT 1, \"season\" TEXT NOT NULL DEFAULT '', \"season_start_month\" INTEGER NULL, \"season_end_month\" INTEGER NULL, \"hide_days_before\" INTEGER NOT NULL DEFAULT 0, \"series_start\" TEXT NULL, PRIMARY KEY (\"id\"));"
