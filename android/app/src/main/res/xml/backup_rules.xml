<!-- Android 11 and earlier (fullBackupContent): the same rule as
     data_extraction_rules.xml, the secure store excluded and nothing else. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
